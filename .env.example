# Public values only. These ship in the browser bundle and are safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
NEXT_PUBLIC_APP_VERSION=0.1.0

# SERVER-SIDE SECRETS: never put these in this file or in git.
# Set them with: supabase secrets set ANTHROPIC_API_KEY=... AI_MODEL_FAST=... AI_MODEL_SMART=...
# Edge Function secrets (set once with `supabase secrets set ...`):
#   ANTHROPIC_API_KEY      provider key (never in the browser)
#   AI_MODEL_FAST          model id for quick entry and reminders (default claude-haiku-5-5)
#   AI_MODEL_SMART         model id for the daily summary (default claude-sonnet-5-5)
#   ALLOWED_ORIGINS        comma-separated site origins allowed to call the functions
#   AI_DAILY_TOKENS_PER_SHOP  optional daily token cap per shop (default 200000)
#   AI_ENABLED             set to "false" to switch every AI feature off (kill switch)
